# ══════════════════════════════════════════════════════════════════════════
# SmartWMS V2 — contoh konfigurasi. Salin menjadi .env.local (dev) / .env (produksi)
# lalu isi nilainya. File .env* selain ini TIDAK di-commit (repo publik).
# ══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL lokal (ARCHITECTURE D-13, D-20) ───────────────────────────
# Dev: database smartwms_dev · Produksi: database smartwms
# Karakter khusus di password wajib di-URL-encode (spasi → %20, @ → %40, # → %23)
DATABASE_URL=postgres://smartwms_app:GANTI_PASSWORD_APP@localhost:5432/smartwms_dev
DATABASE_URL_OWNER=postgres://smartwms_owner:GANTI_PASSWORD_OWNER@localhost:5432/smartwms_dev

# ── Supabase (V1) — masih dipakai sampai ROADMAP Tahap 4 selesai ─────────
# Ambil dari Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Koneksi langsung ke database Supabase — HANYA untuk snapshot & impor data (Tahap 2, cutover).
# Dashboard → Connect → "Session pooler" (port 5432, BUKAN 6543). Password = database password.
SUPABASE_DB_URL=
